      "section": [],
      "text": "EL INGENIOSO HIDALGO DON QUIJOTE DE LA MANCHA\n\nCompuesto por Miguel de Cervantes Saavedra",
      "unit": "p1"
    },
    {
      "anchor": {
        "chars": [9, 192],
        "confidence": 0.97,
        "foliation": "page",
