<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Spdf.Format</AssemblyName>
    <RootNamespace>Spdf</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Security advisories of dependencies stay visible but do not break the build. -->
    <WarningsNotAsErrors>NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <PackageId>Spdf.Format</PackageId>
    <Title>SPDF (Semantic Processed Document Format) for .NET</Title>
    <Description>Read, validate, search, cite and write SPDF files: documents read once and citable forever, because every passage carries its exact anchor (printed page, folio, second of a recording, verse). Reads SPDF 5.0 and the legacy 4.0/4.1 files of Scholaris; canonical JSON dump (RFC 8785), lexical (FTS5), vector and hybrid search, anchor URIs, short citations, CSL-JSON and BibTeX export, Ed25519 integrity.</Description>
    <PackageTags>spdf;citation;pdf;sqlite;fts5;search;csl;bibtex;digital-humanities</PackageTags>
    <PackageLicenseExpression>MIT OR Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://spdf.joseluissaorin.com</PackageProjectUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="8.0.31" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <InternalsVisibleTo Include="Spdf.Format.Tests" />
  </ItemGroup>

</Project>
