{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spdf.joseluissaorin.com/schema/5.0/metadata.schema.json",
  "title": "SPDF 5.0 document metadata",
  "description": "One CSL-JSON item plus the SPDF extension object \"spdf\" (SPEC §6). Other CSL variables are allowed.",
  "type": "object",
  "required": [
    "type",
    "title"
  ],
  "properties": {
    "type": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "title-short": {
      "type": "string"
    },
    "original-title": {
      "type": "string"
    },
    "author": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/name"
      }
    },
    "editor": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/name"
      }
    },
    "translator": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/name"
      }
    },
    "interviewer": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/name"
      }
    },
    "container-author": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/name"
      }
    },
    "issued": {
      "$ref": "#/$defs/date"
    },
    "original-date": {
      "$ref": "#/$defs/date"
    },
    "accessed": {
      "$ref": "#/$defs/date"
    },
    "language": {
      "type": "string"
    },
    "DOI": {
      "type": "string"
    },
    "ISBN": {
      "type": "string"
    },
    "ISSN": {
      "type": "string"
    },
    "URL": {
      "type": "string"
    },
    "spdf": {
      "$ref": "#/$defs/spdf"
    }
  },
  "$defs": {
    "name": {
      "type": "object",
      "properties": {
        "family": {
          "type": "string"
        },
        "given": {
          "type": "string"
        },
        "literal": {
          "type": "string"
        },
        "non-dropping-particle": {
          "type": "string"
        },
        "dropping-particle": {
          "type": "string"
        },
        "suffix": {
          "type": "string"
        }
      },
      "anyOf": [
        {
          "required": [
            "family"
          ]
        },
        {
          "required": [
            "literal"
          ]
        },
        {
          "required": [
            "given"
          ]
        }
      ]
    },
    "date": {
      "type": "object",
      "anyOf": [
        {
          "required": [
            "date-parts"
          ]
        },
        {
          "required": [
            "literal"
          ]
        },
        {
          "required": [
            "raw"
          ]
        }
      ],
      "properties": {
        "date-parts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "integer"
            }
          }
        },
        "literal": {
          "type": "string"
        },
        "raw": {
          "type": "string"
        },
        "circa": {
          "type": [
            "boolean",
            "string",
            "number"
          ]
        }
      }
    },
    "spdf": {
      "type": "object",
      "properties": {
        "provenance": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string"
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          }
        },
        "undated": {
          "type": "object",
          "properties": {
            "from": {
              "type": "integer"
            },
            "to": {
              "type": "integer"
            },
            "basis": {
              "type": "string"
            }
          }
        },
        "original_language": {
          "type": "string"
        },
        "subtitle": {
          "type": "string"
        },
        "orcid": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    }
  }
}
