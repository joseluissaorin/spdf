{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker.ImportScripts"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": false,
    "useDefineForClassFields": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "spdf-format/browser": ["../js/dist/entry/browser.d.ts", "./src/nucleo/simulacros/spdf-format.ts"],
      "spdf-infer-web": ["../models/web/dist/index.d.ts", "./src/nucleo/simulacros/spdf-infer-web.ts"]
    }
  },
  "include": ["src"]
}
